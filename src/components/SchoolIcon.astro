---
// Page-scoped icons for the In-the-Schools page (the "how it works" beats and
// the award ribbon). Generic icons (pin, supplies) use the shared Icon.astro;
// these are page-specific so they stay local rather than bloating the shared set.
interface Props {
  name: string;
}
const { name } = Astro.props;
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{name === "van" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M3 6h11v9H2V9z" /><path d="M14 9h4l3 3v3h-7z" /><circle cx="6.5" cy="17" r="1.8" /><circle cx="16.5" cy="17" r="1.8" /></svg>
)}
{name === "supplies" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-5l-2-2H5a2 2 0 0 0-2 2z" /></svg>
)}
{name === "book" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
)}
{name === "frame" && (
  <svg viewBox="0 0 24 24" {...stroke}><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
)}
