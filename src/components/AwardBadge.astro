---
// Quiet trust-signal badge for Readers' Choice awards. Shared + component-scoped
// so it renders consistently on every page (about, in-the-schools, for-kids,
// summer-program, homepage). All awards are 2024 Northumberland News Readers'
// Choice. Pass a tier ("Diamond Winner" / "Platinum Winner" / "Gold Winner")
// for a specific award, or a subtitle override for a summary badge.
interface Props {
  title: string;
  tier?: string;
  /** Override the default subtitle (used for the homepage summary badge). */
  subtitle?: string;
}
const { title, tier, subtitle } = Astro.props;
const sub =
  subtitle ??
  (tier
    ? `2024 ${tier} · Northumberland News Readers' Choice`
    : "Northumberland News Readers' Choice");
---

<div class="award-badge">
  <span class="ribbon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8" r="6" />
      <path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12" />
    </svg>
  </span>
  <div class="award-badge-text">
    <div class="t">{title}</div>
    <div class="s">{sub}</div>
  </div>
</div>

<style>
  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 13px 18px 13px 14px;
    box-shadow: 0 4px 14px -8px rgba(28, 26, 23, 0.12);
  }
  .ribbon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 9px;
    background: color-mix(in srgb, var(--c-yellow) 22%, transparent);
    color: #9a6b12;
    display: grid;
    place-items: center;
  }
  .ribbon svg { width: 20px; height: 20px; }
  .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s { font-size: 11.5px; color: var(--muted); margin-top: 2px; }
</style>
