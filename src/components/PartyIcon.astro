---
// Page-scoped icon set for the Birthday Parties page (glance chips, "what's
// included" cards, and the theme tiles). Kept local rather than added to the
// shared Icon.astro because most of these are birthday-theme-specific.
interface Props {
  name: string;
}
const { name } = Astro.props;
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{name === "clock" && (
  <svg viewBox="0 0 24 24" {...stroke}><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
)}
{name === "cabin" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M3 10l9-7 9 7" /><path d="M5 9v11h14V9" /><path d="M9 20v-6h6v6" /></svg>
)}
{name === "users" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
)}
{name === "palette" && (
  <svg viewBox="0 0 24 24" {...stroke}>
    <circle cx="13.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" />
    <circle cx="17.5" cy="10.5" r="1.5" fill="currentColor" stroke="none" />
    <circle cx="8.5" cy="7.5" r="1.5" fill="currentColor" stroke="none" />
    <circle cx="6.5" cy="12.5" r="1.5" fill="currentColor" stroke="none" />
    <path d="M12 2C6.5 2 2 6 2 11c0 4 3 7 7 7 1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.4-.5-.8-.5-1.3 0-1 .8-1.7 1.8-1.7H14c3.3 0 6-2.7 6-6 0-3.9-3.6-6-8-6z" />
  </svg>
)}
{name === "brush" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M9.06 11.9l8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08" /><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z" /></svg>
)}
{name === "gift" && (
  <svg viewBox="0 0 24 24" {...stroke}><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M12 8C12 8 11 2 8 2a2.5 2.5 0 0 0 0 5h4zM12 8c0 0 1-6 4-6a2.5 2.5 0 0 1 0 5h-4z" /></svg>
)}
{name === "home" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M9 22V12h6v10" /></svg>
)}
{name === "sparkle" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8" /></svg>
)}
{name === "landscape" && (
  <svg viewBox="0 0 24 24" {...stroke}><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8" cy="9" r="1.6" /><path d="M3 17l5-5 4 4 3-3 6 6" /></svg>
)}
{name === "pottery" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M7 3h10l-1.5 3.5a6 6 0 0 1 1.5 4A6.5 6.5 0 0 1 12 21a6.5 6.5 0 0 1-5-10.5A6 6 0 0 1 8.5 6.5z" /><path d="M8.5 6.5h7" /></svg>
)}
{name === "portrait" && (
  <svg viewBox="0 0 24 24" {...stroke}><circle cx="12" cy="9" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
)}
{name === "watercolour" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z" /></svg>
)}
{name === "cartoon" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.6-.8L3 21l1.9-5.7A8.38 8.38 0 0 1 3.5 11 8.5 8.5 0 0 1 12 2.5a8.38 8.38 0 0 1 8.5 8.5z" /><path d="M9 10.5h.01M15 10.5h.01M9 14c.8.7 1.9 1 3 1s2.2-.3 3-1" /></svg>
)}
{name === "animation" && (
  <svg viewBox="0 0 24 24" {...stroke}><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5" /></svg>
)}
{name === "jewelry" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M6 3h12l3 6-9 12L3 9z" /><path d="M3 9h18M9 3l-1.5 6L12 21M15 3l1.5 6L12 21" /></svg>
)}
{name === "mask" && (
  <svg viewBox="0 0 24 24" {...stroke}><path d="M3 4s2 0 3.5 1C8 3.5 10 3 12 3s4 .5 5.5 2C19 4 21 4 21 4s.5 7-2 11c-1.6 2.5-4.5 4-7 4s-5.4-1.5-7-4C2.5 11 3 4 3 4z" /><path d="M8.5 11h.01M15.5 11h.01M9 15c.8.6 1.9.9 3 .9s2.2-.3 3-.9" /></svg>
)}
