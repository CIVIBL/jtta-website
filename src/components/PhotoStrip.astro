---
interface StripItem {
  /** Placeholder label / expected photo subject, shown until `src` is set */
  placeholder?: string;
  /** Optional hand-written caption overlaid on the photo */
  caption?: string;
  /** Real image path, e.g. "/images/kids-strip-1-worktable.jpg" */
  src?: string;
  /** Describes what the photo actually shows */
  alt?: string;
  /** Intrinsic file size, so the browser reserves space before load */
  width?: number;
  height?: number;
}

interface Props {
  items: StripItem[];
  /** Render on the white "paper" surface instead of cream. */
  onPaper?: boolean;
}

const { items, onPaper = false } = Astro.props;
---

<div class:list={["k-strip", { "on-paper": onPaper }]}>
  <div class="wrap">
    <div class="k-strip-grid">
      {
        items.map((it) => (
          <figure>
            {it.src ? (
              <img src={it.src} alt={it.alt ?? it.placeholder ?? ""} width={it.width} height={it.height} loading="lazy" />
            ) : (
              <div class="ph">{it.placeholder}</div>
            )}
            {it.caption && <figcaption>{it.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</div>
