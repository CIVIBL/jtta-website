---
// Decorative ink splat: the logo's silhouette without the lettering (path from scripts/splat-path.mjs).
// Position it from the parent (class/style); it never takes pointer events.
interface Props {
  /** Colour token name, e.g. "turquoise" renders var(--c-turquoise). */
  color?: "teal" | "turquoise" | "yellow" | "red" | "sage" | "blue" | "plum";
  /** Width as a CSS length; height follows the splat's aspect ratio. */
  size?: string;
  /** Rotation in degrees. */
  rotate?: number;
  opacity?: number;
  class?: string;
  style?: string;
}
const { color = "turquoise", size = "48px", rotate = 0, opacity = 1, class: cls, style } = Astro.props;
