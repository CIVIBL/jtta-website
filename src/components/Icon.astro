---
// Small inline icon set (line icons, stroke = currentColor). Size/colour come
// from the parent's CSS. Used across the For Kids page.
interface Props {
  name:
    | "group"
    | "hands"
    | "supplies"
    | "calendar"
    | "check"
    | "bag"
    | "pin"
    | "car"
    | "spark"
    | "clock"
    | "heart"
    | "users"
    | "wine"
    | "music"
    | "drama"
    | "art"
    | "star"
    | "rotate"
    | "curtain";
}
const { name } = Astro.props;
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{
  name === "group" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
  )
}
{
  name === "hands" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M12 19l7-7 3 3-7 7-3-3z" />
      <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
      <path d="M2 2l7.586 7.586" />
      <circle cx="11" cy="11" r="2" />
    </svg>
  )
}
{
  name === "supplies" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-5l-2-2H5a2 2 0 0 0-2 2z" />
    </svg>
  )
}
{
  name === "calendar" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <path d="M16 2v4M8 2v4M3 10h18" />
    </svg>
  )
}
{
  name === "check" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6L9 17l-5-5" />
    </svg>
  )
}
{
  name === "bag" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
      <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
    </svg>
  )
}
{
  name === "pin" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
      <circle cx="12" cy="10" r="3" />
    </svg>
  )
}
{
  name === "car" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M5 17H3v-5l2-5h11l3 5h2v5h-2" />
      <circle cx="7.5" cy="17" r="1.5" />
      <circle cx="16.5" cy="17" r="1.5" />
    </svg>
  )
}
{
  name === "spark" && (
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4z" />
    </svg>
  )
}
{
  name === "clock" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 6v6l4 2" />
    </svg>
  )
}
{
  name === "heart" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
    </svg>
  )
}
{
  name === "users" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
    </svg>
  )
}
{
  name === "wine" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M8 22h8M12 15v7M5 3h14l-1.2 6a5.8 5.8 0 0 1-11.6 0L5 3z" />
    </svg>
  )
}
{
  name === "music" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M9 18V5l12-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="18" cy="16" r="3" />
    </svg>
  )
}
{
  name === "drama" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M3 5v6a5 5 0 0 0 10 0V5z" />
      <path d="M3 9c2.5 1.5 7.5 1.5 10 0" />
      <path d="M14 13.5a5 5 0 0 0 7-1.5V6h-7" />
    </svg>
  )
}
{
  name === "art" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <circle cx="13.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="17.5" cy="10.5" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="8.5" cy="7.5" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="6.5" cy="12.5" r="1.5" fill="currentColor" stroke="none" />
      <path d="M12 2C6.5 2 2 6 2 11c0 4 3 7 7 7 1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.4-.5-.8-.5-1.3 0-1 .8-1.7 1.8-1.7H14c3.3 0 6-2.7 6-6 0-3.9-3.6-6-8-6z" />
    </svg>
  )
}
{
  name === "star" && (
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7-6.2-3.8L5.8 21l1.6-7L2 9.5l7.1-.6z" />
    </svg>
  )
}
{
  name === "rotate" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
      <path d="M21 3v5h-5" />
      <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
      <path d="M3 21v-5h5" />
    </svg>
  )
}
{
  name === "curtain" && (
    <svg viewBox="0 0 24 24" {...stroke}>
      <path d="M2 3h20" />
      <path d="M4 3v18c3 0 5-2 5-6V3" />
      <path d="M20 3v18c-3 0-5-2-5-6V3" />
    </svg>
  )
}
