---
import type { CollectionEntry } from "astro:content";
import {
  buildMailto,
  durationMinutes,
  formatAgeRange,
  formatDay,
  formatDow,
  formatDuration,
  formatMonth,
  formatTimeRange,
  SESSION_FULL_LABEL,
  STATUS_LABEL,
} from "../lib/workshops";

interface Props {
  workshop: CollectionEntry<"workshops">;
}

const { workshop } = Astro.props;
const w = workshop.data;

const pill = w.special
  ? `${formatDuration(durationMinutes(w.startTime, w.endTime))} · special`
  : w.sessions > 1
    ? `${w.sessions}-week series`
    : "Workshop";

const ageLabel = w.audience === "adults" ? "Adults" : `Ages ${formatAgeRange(w.ageMin, w.ageMax)}`;
const href = buildMailto(w.title, w.date);
const isFull = w.status === "full";
const registerText = w.status === "waitlist" ? "Email to join waitlist" : "Email to register";
---

{/* The row is a plain container so its text is selectable; only the register text is a link.
    The arrow circle repeats it for mouse users but is skipped by keyboard and screen readers.
    A full workshop shows plain "Session full" text and a muted, non-link arrow instead. */}
<article class:list={["workshop-row", { "is-special": w.special, "is-full": isFull }]}>
  <div class="w-date">
    <span class="w-month">{formatMonth(w.date)} · {formatDow(w.date)}</span>
    <span class="w-day">{formatDay(w.date)}</span>
    <span class="w-time">{formatTimeRange(w.startTime, w.endTime)}</span>
  </div>
  <div class="w-body">
    <h3>{w.title}</h3>
    <div class="w-meta">
      <span class="pill">{pill}</span>
      <span>{ageLabel}</span>
      {w.status !== "open" && <span class={`pill is-${w.status}`}>{STATUS_LABEL[w.status]}</span>}
    </div>
    {
      isFull ? (
        <span class="w-register">{SESSION_FULL_LABEL}</span>
      ) : (
        <a class="w-register" href={href} aria-label={`${registerText} for ${w.title}`}>{registerText} →</a>
      )
    }
  </div>
  {
    isFull ? (
      <span class="w-cta" aria-hidden="true">→</span>
    ) : (
      <a class="w-cta" href={href} tabindex="-1" aria-hidden="true">→</a>
    )
  }
</article>
