---
import type { CollectionEntry } from "astro:content";
import {
  buildMailto,
  durationMinutes,
  formatAgeRange,
  formatDay,
  formatDow,
  formatDuration,
  formatMonth,
  formatPrice,
  formatTimeRange,
  PRICE_NOTE,
} from "../lib/workshops";

interface Props {
  workshop: CollectionEntry<"workshops">;
}

const { workshop } = Astro.props;
const w = workshop.data;

const pill = w.special
  ? `${formatDuration(durationMinutes(w.startTime, w.endTime))} · special`
  : w.sessions > 1
    ? `${w.sessions}-week series`
    : "Workshop";

const ageLabel = w.audience === "adults" ? "Adults" : `Ages ${formatAgeRange(w.ageMin, w.ageMax)}`;
const priceNote = w.sessions > 1 ? "full series" : PRICE_NOTE;
---

<a class:list={["workshop-row", { "is-special": w.special }]} href={buildMailto(w.title, w.date)}>
  <div class="w-date">
    <span class="w-month">{formatMonth(w.date)} · {formatDow(w.date)}</span>
    <span class="w-day">{formatDay(w.date)}</span>
    <span class="w-time">{formatTimeRange(w.startTime, w.endTime)}</span>
  </div>
  <div class="w-body">
    <h3>{w.title}</h3>
    <div class="w-meta">
      <span class="pill">{pill}</span>
      <span>{ageLabel}</span>
      <span>·</span>
      <span>{formatPrice(w.price)} {priceNote}</span>
    </div>
  </div>
  <div class="w-cta">→</div>
</a>
