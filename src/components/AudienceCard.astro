---
interface Props {
  label: string;
  meta: string;
  /** Real destination. Omit to render a non-link card (no dead href="#"). */
  href?: string;
}

const { label, meta, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="audience-card" href={href}>
  <div>
    <div class="a-label">{label}</div>
    <div class="a-meta">{meta}</div>
  </div>
  <div class="a-icon">→</div>
</Tag>
