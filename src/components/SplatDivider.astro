---
// Full-width band of scattered droplets between two sections. Decorative, static, max 48px tall.
import Splat from "./Splat.astro";

// left %, size px, rotation, colour, opacity, vertical offset px
const DROPS: [number, number, number, "turquoise" | "yellow", number, number][] = [
  [4, 22, 20, "turquoise", 0.7, 14],
  [15, 34, -35, "yellow", 0.8, 6],
  [27, 14, 60, "turquoise", 0.65, 22],
  [38, 40, 10, "turquoise", 0.75, 2],
  [51, 18, -70, "yellow", 0.7, 18],
  [62, 28, 45, "turquoise", 0.6, 10],
  [74, 16, -15, "yellow", 0.8, 24],
  [85, 36, 80, "yellow", 0.7, 4],
  [95, 20, -50, "turquoise", 0.75, 16],
];
---

<div class="splat-divider" aria-hidden="true">
  {DROPS.map(([left, size, rot, color, op, top]) => (
    <Splat color={color} size={`${size}px`} rotate={rot} opacity={op} style={`position: absolute; left: ${left}%; top: ${top}px;`} />
  ))}
</div>

<style>
  .splat-divider { position: relative; height: 48px; overflow: hidden; width: 100%; }
</style>
