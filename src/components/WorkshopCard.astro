---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import {
  buildMailto,
  durationMinutes,
  formatAgeRange,
  formatDay,
  formatDow,
  formatDuration,
  formatMonth,
  formatPrice,
  formatSessions,
  formatTimeRange,
  PRICE_NOTE,
} from "../lib/workshops";
import { mailto, CONTACT_EMAIL } from "../lib/site";

interface Props {
  workshop: CollectionEntry<"workshops">;
}

const { workshop } = Astro.props;
const w = workshop.data;

// Accent tokens stay a component concern — content stores a name, not CSS.
const accentVar = {
  red: "var(--c-red)",
  yellow: "var(--c-yellow)",
  sage: "var(--c-sage)",
  blue: "var(--c-blue)",
  plum: "var(--c-plum)",
}[w.accent];

// The studio is one person; not worth a schema field until that changes.
const instructor = "Christine Benson";
const initials = "CB";

const duration = formatDuration(durationMinutes(w.startTime, w.endTime));
const timeSub = w.sessions > 1 ? `${duration} each` : duration;
const priceSub = w.sessions > 1 ? "full series" : PRICE_NOTE;
const ctaLabel =
  w.status === "waitlist"
    ? "Join the waitlist →"
    : w.status === "full"
      ? "Session full"
      : "Email to register →";
---

<article class:list={["k-card", `is-${w.status}`]}>
  <div class="k-card-top">
    <span class="k-cat"><span class="dot" style={`background: ${accentVar};`}></span>{w.category}</span>
  </div>
  <h3>{w.title}</h3>
  <p class="k-blurb">{w.blurb}</p>

  <div class="k-meta">
    <div>
      <div class="lbl">Ages</div>
      <div class="val">{formatAgeRange(w.ageMin, w.ageMax)}<small>years</small></div>
    </div>
    <div>
      <div class="lbl">When</div>
      <div class="val">{formatDow(w.date)} · {formatMonth(w.date)} {formatDay(w.date)}<small>{formatSessions(w.sessions)}</small></div>
    </div>
    <div>
      <div class="lbl">Time</div>
      <div class="val">{formatTimeRange(w.startTime, w.endTime)}<small>{timeSub}</small></div>
    </div>
    <div>
      <div class="lbl">{w.audience === "adults" ? "Per person" : "Per child"}</div>
      <div class="val">{formatPrice(w.price)}<small>{priceSub}</small></div>
    </div>
  </div>

  <div class="k-by">
    <span class="av">{initials}</span>
    <span>Led by <b>{instructor}</b></span>
  </div>

  <div class="k-mats">
    <div class="prov">
      <div class="lbl"><Icon name="check" /> Provided</div>
      <p>{w.provided}</p>
    </div>
    <div class="bring">
      <div class="lbl"><Icon name="bag" /> Bring</div>
      <p>{w.bring}</p>
    </div>
  </div>

  <div class="k-card-foot">
    <a class="btn is-primary" href={buildMailto(w.title, w.date)}>{ctaLabel}</a>
    {
      w.status !== "full" && (
        <span class="k-register-addr">
          or write to <a href={mailto()}>{CONTACT_EMAIL}</a>
        </span>
      )
    }
  </div>
</article>

<style>
  /* WorkshopCard's own styles — scoped, so they travel with the component to
     any page (/for-kids, /for-adults, …). Page layout (the .k-list grid that
     arranges multiple cards) stays in the page stylesheet. The base .btn
     utility lives in global.css; only card-specific overrides live here. */
  .k-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 26px 26px 22px;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .k-card:hover {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -16px rgba(28,26,23,0.18);
  }
  .k-card.is-full { opacity: 0.86; }

  .k-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
  }
  .k-cat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .k-cat .dot { width: 9px; height: 9px; border-radius: 50%; }

  .k-card h3 {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .k-card .k-blurb {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 18px;
  }

  /* facts grid inside card */
  .k-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .k-meta div {
    background: var(--bg);
    padding: 12px 14px;
  }
  .k-meta .lbl {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3px;
  }
  .k-meta .val {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink);
  }
  .k-meta .val small {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    color: var(--muted);
    display: block;
    margin-top: 1px;
  }

  .k-card .k-by {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 14px;
  }
  .k-card .k-by .av {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--c-plum);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .k-card .k-by b { color: var(--ink); font-weight: 600; }

  /* materials split */
  .k-mats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 14px;
    background: var(--bg);
    border-radius: 12px;
    margin-bottom: 18px;
  }
  @media (max-width: 420px) { .k-mats { grid-template-columns: 1fr; } }
  .k-mats .lbl {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* svg is rendered by the child <Icon> component — :global() so the parent's
     scoped style can still size it (Astro scoping doesn't cross components). */
  .k-mats .lbl :global(svg) { width: 13px; height: 13px; }
  .k-mats .prov .lbl { color: var(--c-sage); }
  .k-mats .bring .lbl { color: var(--c-red); }
  .k-mats p { margin: 0; font-size: 13px; line-height: 1.45; color: var(--ink-soft); }

  .k-card-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .k-card .btn { padding: 11px 18px; }
  .k-register-addr {
    font-size: 13px;
    color: var(--muted);
  }
  .k-register-addr a {
    color: var(--c-red);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .k-card.is-full .k-card-foot .btn {
    background: transparent;
    color: var(--muted);
    border-color: var(--rule-strong);
    pointer-events: none;
  }
</style>
