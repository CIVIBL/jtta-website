---
import Icon from "./Icon.astro";

type Status = "open" | "almost" | "waitlist" | "full";

interface Props {
  /** Category label, e.g. "Watercolour" or "4-week series" */
  cat: string;
  /** Dot colour — a token reference, e.g. "var(--c-blue)" */
  color: string;
  title: string;
  blurb: string;
  /** Age range, e.g. "Ages 7 – 10" (the "Ages " prefix is stripped for display) */
  ages: string;
  dates: string;
  datesSub: string;
  time: string;
  timeSub: string;
  price: string;
  priceSub: string;
  /** Instructor name */
  by: string;
  provided: string;
  bring: string;
  status: Status;
}

const {
  cat,
  color,
  title,
  blurb,
  ages,
  dates,
  datesSub,
  time,
  timeSub,
  price,
  priceSub,
  by,
  provided,
  bring,
  status,
} = Astro.props;

const ageValue = ages.replace("Ages ", "");
const initials = by
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const subject = `Register · ${title} (${dates})`;
const mailto = `mailto:jttacabin@gmail.com?subject=${encodeURIComponent(subject)}`;

const ctaLabel =
  status === "waitlist"
    ? "Join the waitlist →"
    : status === "full"
      ? "Session full"
      : "Email to register →";
---

<article class:list={["k-card", `is-${status}`]}>
  <div class="k-card-top">
    <span class="k-cat"><span class="dot" style={`background: ${color};`}></span>{cat}</span>
  </div>
  <h3>{title}</h3>
  <p class="k-blurb">{blurb}</p>

  <div class="k-meta">
    <div>
      <div class="lbl">Ages</div>
      <div class="val">{ageValue}<small>years</small></div>
    </div>
    <div>
      <div class="lbl">When</div>
      <div class="val">{dates}<small>{datesSub}</small></div>
    </div>
    <div>
      <div class="lbl">Time</div>
      <div class="val">{time}<small>{timeSub}</small></div>
    </div>
    <div>
      <div class="lbl">Per child</div>
      <div class="val">{price}<small>{priceSub}</small></div>
    </div>
  </div>

  <div class="k-by">
    <span class="av">{initials}</span>
    <span>Led by <b>{by}</b></span>
  </div>

  <div class="k-mats">
    <div class="prov">
      <div class="lbl"><Icon name="check" /> Provided</div>
      <p>{provided}</p>
    </div>
    <div class="bring">
      <div class="lbl"><Icon name="bag" /> Bring</div>
      <p>{bring}</p>
    </div>
  </div>

  <div class="k-card-foot">
    <a class="btn is-primary" href={mailto}>{ctaLabel}</a>
  </div>
</article>
