---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mailto, CONTACT_EMAIL } from "../lib/site";
---

<BaseLayout title="Page not found · Journey Through the Arts" noindex>
  <section>
    <div class="wrap">
      <div class="eyebrow">Page not found</div>
      <h1 class="section-title" style="margin-top: 12px;">
        Sorry, we can't find <em>that page</em>.
      </h1>
      <p class="section-lede">
        The page you're looking for may have moved, or the link may be out of date.
      </p>
      <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap;">
        <a class="btn is-primary" href="/">Back to the homepage</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Can't find what you <em>need</em>?</h2>
      <p>Email Christine and she'll reply to you directly.</p>
      <p class="cta-email"><a href={mailto()}>{CONTACT_EMAIL}</a></p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a class="btn is-light" href={mailto()}>Email Christine</a>
      </div>
    </div>
  </section>
</BaseLayout>
