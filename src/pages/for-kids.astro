---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import { isUpcoming } from "../lib/workshops";
import { mailto, CONTACT_EMAIL, MAPS_URL } from "../lib/site";
import "../styles/for-kids.css";

const kidsWorkshops = (await getCollection("workshops"))
  .filter((w) => w.data.audience === "kids" && isUpcoming(w.data.date))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

interface QuickFact {
  icon: "group" | "hands" | "supplies" | "calendar";
  b: string;
  s: string;
}
const QUICK_FACTS: QuickFact[] = [
  { icon: "group", b: "Small groups", s: "6 - 12 kids per session" },
  { icon: "hands", b: "Hands-on, mixed media", s: "Paint, clay, print & more" },
  { icon: "supplies", b: "All supplies included", s: "Just bring a smock" },
  { icon: "calendar", b: "Drop-in or series", s: "Single days & multi-week" },
];

// Kids-page photos aren't shot yet, so no `src` — PhotoStrip renders labelled
// placeholders until the files exist. Add `src: "/images/…"` per item (or wire
// via CMS) when they land; the component already handles it (see PhotoStrip H1).
const STRIP_ONE = [
  { placeholder: "Kids at the worktable", caption: "messy hands, happy kids" },
  { placeholder: "Finished clay projects" },
  { placeholder: "Painting close-up" },
];
const STRIP_TWO = [
  { placeholder: "The cabin studio interior", caption: "our 1840s cabin" },
  { placeholder: "Drying rack of paintings" },
  { placeholder: "Kid holding their artwork" },
];
---

<BaseLayout
  title="For Kids - Workshops at Journey Through the Arts, Port Hope"
  activeNav="kids"
>
  {/* ─── PAGE HEADER ─── */}
  <section class="k-head" id="top">
    <div class="wrap">
      <div class="k-crumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="cur">For Kids</span>
      </div>
      <div class="k-head-grid">
        <div>
          <span class="k-hand">Learn, create, inspire -</span>
          <h1>Workshops for <em>curious kids</em></h1>
          <p class="k-lede">
            After-school and weekend art workshops in our 1840s log-cabin studio, run by Christine
            Benson. Kids work in small groups, get their hands messy with real materials, and take
            something home every single time.
          </p>
          <div class="k-facts">
            {
              QUICK_FACTS.map((f) => (
                <div class="k-fact">
                  <span class="ic"><Icon name={f.icon} /></span>
                  <div>
                    <b>{f.b}</b>
                    <span>{f.s}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="k-head-photo">
          {/* TODO: real photo — kids painting in the cabin studio. Expected at /images/kids-hero.jpg */}
          <div class="ph">Kids painting in the cabin studio</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── WORKSHOP LISTING ─── */}
  <section class="k-list-sec" id="workshops">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Upcoming kids workshops</div>
          <h2 class="section-title" style="margin-top: 12px;">
            What's running <em>this month</em>
          </h2>
          <p class="section-lede">
            Pick the workshops that catch your kid's eye. Most run after school, Monday through
            Thursday from 4:45 to 5:45 pm, with longer projects on weekends and P.A. days. All
            supplies included. Email Christine to hold a spot, she confirms each one personally!
          </p>
        </div>
      </div>

      {
        kidsWorkshops.length === 0 ? (
          <div class="k-empty">
            <div class="k-empty-mark"><Icon name="spark" /></div>
            <h3>No workshops on the calendar <em>just yet</em></h3>
            <p>
              We're busy planning the next round of kids' workshops. Drop Christine a note and she'll
              add you to the list - you'll be the first to hear when new dates open up.
            </p>
            <div class="k-empty-ctas">
              <a class="btn is-primary" href={mailto("Notify me about kids workshops")}>Get notified →</a>
              <a class="btn is-line" href="/#summer">Ask about summer camp</a>
            </div>
          </div>
        ) : (
          <div class="k-list">
            {kidsWorkshops.map((w) => <WorkshopCard workshop={w} />)}
          </div>
        )
      }
    </div>
  </section>

  {/* ─── PHOTO STRIP (below the listing) ─── */}
  <PhotoStrip items={STRIP_ONE} />

  {/* ─── GOOD TO KNOW ─── */}
  <section class="k-know" id="know">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">First time here?</div>
          <h2 class="section-title" style="margin-top: 12px;">
            A few <em>good things</em> to know
          </h2>
          <p class="section-lede">
            New to the cabin? Here's the practical stuff so drop-off day feels easy. Still have a
            question? Christine answers her email personally, just ask!
          </p>
        </div>
      </div>
      <div class="k-know-grid">
        <div class="k-know-card">
          <span class="ic"><Icon name="pin" /></span>
          <h3>Where</h3>
          <p>The log-cabin studio at <b>190 Hope St N in Port Hope</b>. Park on the street; the studio entrance is round the side.</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="car" /></span>
          <h3>Drop-off & pickup</h3>
          <p>Drop off up to 5 min early. Please walk younger kids in and pick them up at the door. Christine likes to say hello!</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="supplies" /></span>
          <h3>What's provided</h3>
          <p>All supplies for the project are included: paints, clay, paper, tools, etc. No need to buy a thing.</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="bag" /></span>
          <h3>What to bring</h3>
          <p>Just a smock or an old shirt (art gets messy!) and a water bottle. We'll note anything extra on the workshop.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── PHOTO STRIP (below "First time here?", on cream) ─── */}
  <PhotoStrip items={STRIP_TWO} />

  {/* ─── CTA ─── */}
  <section class="cta">
    <div class="wrap">
      <h2>Ready to get a little <em>paint</em> on them?</h2>
      <p>
        Email Christine to hold a spot, ask about a workshop, or check what's coming up next. She'll
        reply to you directly. No carts, no accounts.
      </p>
      <p class="cta-email"><a href={mailto()}>{CONTACT_EMAIL}</a></p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a class="btn is-light" href={mailto()}>Email Christine</a>
        <a class="btn is-outline" href={MAPS_URL} target="_blank" rel="noopener">Find the cabin →</a>
      </div>
    </div>
  </section>
</BaseLayout>
