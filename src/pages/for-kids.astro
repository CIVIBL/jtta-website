---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import "../styles/for-kids.css";

interface QuickFact {
  icon: "group" | "hands" | "supplies" | "calendar";
  b: string;
  s: string;
}
const QUICK_FACTS: QuickFact[] = [
  { icon: "group", b: "Small groups", s: "6 – 12 kids per session" },
  { icon: "hands", b: "Hands-on, mixed media", s: "Paint, clay, print & more" },
  { icon: "supplies", b: "All supplies included", s: "Just bring a smock" },
  { icon: "calendar", b: "Drop-in or series", s: "Single days & multi-week" },
];

interface Workshop {
  cat: string;
  color: string;
  title: string;
  blurb: string;
  ages: string;
  dates: string;
  datesSub: string;
  time: string;
  timeSub: string;
  price: string;
  priceSub: string;
  by: string;
  provided: string;
  bring: string;
  status: "open" | "almost" | "waitlist" | "full";
}
const WORKSHOPS: Workshop[] = [
  {
    cat: "Watercolour", color: "var(--c-blue)",
    title: "Watercolour Wonders",
    ages: "Ages 7 – 10",
    dates: "Sat · Jun 14", datesSub: "Single session",
    time: "10:00 – 11:30 am", timeSub: "90 min",
    price: "$32", priceSub: "incl. HST",
    by: "Christine Benson",
    blurb: "Loose, happy watercolour painting — wet-on-wet skies, salt textures and a finished landscape to frame.",
    provided: "Paper, paints, brushes & aprons",
    bring: "A water bottle & a smile",
    status: "almost",
  },
  {
    cat: "Clay", color: "var(--c-red)",
    title: "Clay Critters",
    ages: "Ages 5 – 7",
    dates: "Wed · Jun 18", datesSub: "Single session",
    time: "4:00 – 5:00 pm", timeSub: "60 min",
    price: "$28", priceSub: "incl. HST",
    by: "Christine Benson",
    blurb: "Little hands, big imaginations. We pinch, roll and sculpt air-dry clay animals to paint and take home.",
    provided: "Air-dry clay, tools & paint",
    bring: "Nothing — we've got it",
    status: "open",
  },
  {
    cat: "4-week series", color: "var(--c-plum)",
    title: "Comic Book Creators",
    ages: "Ages 10 – 13",
    dates: "Mondays · Jun 2 – 23", datesSub: "4 weekly sessions",
    time: "4:45 – 6:00 pm", timeSub: "75 min each",
    price: "$96", priceSub: "full series",
    by: "Christine Benson",
    blurb: "Build a character, draw your panels and ink a finished mini-comic over four weeks. Same kids, same crew each week.",
    provided: "Pens, markers, paper & inks",
    bring: "Story ideas welcome",
    status: "open",
  },
  {
    cat: "Printmaking", color: "var(--c-sage)",
    title: "Lino Printmaking",
    ages: "Ages 11 – 15",
    dates: "Thu · Jun 26", datesSub: "Single session",
    time: "4:30 – 6:00 pm", timeSub: "90 min",
    price: "$36", priceSub: "incl. HST",
    by: "Christine Benson",
    blurb: "Carve a soft lino block and pull a small edition of hand-printed cards. Real printmaking, kid-sized.",
    provided: "Lino, cutters, ink & a brayer",
    bring: "Closed-toe shoes",
    status: "waitlist",
  },
  {
    cat: "P.A. day · 2 hrs", color: "var(--c-yellow)",
    title: "Fairy Jar Houses",
    ages: "Ages 6 – 9",
    dates: "Fri · Jun 27", datesSub: "P.A. day special",
    time: "10:00 – 12:00 pm", timeSub: "2 hours",
    price: "$44", priceSub: "incl. HST",
    by: "Christine Benson",
    blurb: "Turn a jar into a glowing fairy house with clay, moss and fairy lights. A longer, cozy P.A.-day project.",
    provided: "Jar, clay, lights & trims",
    bring: "A packed snack",
    status: "open",
  },
  {
    cat: "Mixed media", color: "var(--c-blue)",
    title: "Mixed-Media Mandalas",
    ages: "Ages 8 – 12",
    dates: "Tue · Jun 24", datesSub: "Single session",
    time: "4:45 – 5:45 pm", timeSub: "60 min",
    price: "$30", priceSub: "incl. HST",
    by: "Christine Benson",
    blurb: "Layer paint, paper and pen into a calming radial design. A favourite for focus and quiet flow.",
    provided: "All papers, paints & pens",
    bring: "A smock or old shirt",
    status: "full",
  },
];

const STRIP_ONE = [
  { placeholder: "Kids at the worktable", caption: "messy hands, happy kids", src: "/images/kids-worktable.jpg" },
  { placeholder: "Finished clay projects", src: "/images/kids-clay-projects.jpg" },
  { placeholder: "Painting close-up", src: "/images/kids-painting-closeup.jpg" },
];
const STRIP_TWO = [
  { placeholder: "The cabin studio interior", caption: "our 1840s cabin", src: "/images/cabin-interior.jpg" },
  { placeholder: "Drying rack of paintings", src: "/images/drying-rack.jpg" },
  { placeholder: "Kid holding their artwork", src: "/images/kid-artwork.jpg" },
];
---

<BaseLayout
  title="For Kids — Workshops at Journey Through the Arts, Port Hope"
  activeNav="kids"
>
  {/* ─── PAGE HEADER ─── */}
  <section class="k-head" id="top">
    <div class="wrap">
      <div class="k-crumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="cur">For Kids</span>
      </div>
      <div class="k-head-grid">
        <div>
          <span class="k-hand">Learn, create, inspire —</span>
          <h1>Workshops for <em>curious kids</em></h1>
          <p class="k-lede">
            After-school and weekend art workshops in our 1840s log-cabin studio, run by Christine
            Benson. Kids work in small groups, get their hands messy with real materials, and take
            something home every single time.
          </p>
          <div class="k-facts">
            {
              QUICK_FACTS.map((f) => (
                <div class="k-fact">
                  <span class="ic"><Icon name={f.icon} /></span>
                  <div>
                    <b>{f.b}</b>
                    <span>{f.s}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="k-head-photo">
          {/* TODO: real photo — kids painting in the cabin studio. Expected at /images/kids-hero.jpg */}
          <div class="ph">Kids painting in the cabin studio</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── WORKSHOP LISTING ─── */}
  <section class="k-list-sec" id="workshops">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Upcoming kids workshops</div>
          <h2 class="section-title" style="margin-top: 12px;">
            What's running <em>this month</em>
          </h2>
          <p class="section-lede">
            Pick the workshops that catch your kid's eye. Most run after school, Monday through
            Thursday from 4:45 to 5:45 pm, with longer projects on weekends and P.A. days. All
            supplies included. Email Christine to hold a spot, she confirms each one personally!
          </p>
        </div>
      </div>

      {
        WORKSHOPS.length === 0 ? (
          <div class="k-empty">
            <div class="k-empty-mark"><Icon name="spark" /></div>
            <h3>No workshops on the calendar <em>just yet</em></h3>
            <p>
              We're busy planning the next round of kids' workshops. Drop Christine a note and she'll
              add you to the list — you'll be the first to hear when new dates open up.
            </p>
            <div class="k-empty-ctas">
              <a class="btn is-primary" href="mailto:jttacabin@gmail.com?subject=Notify me about kids workshops">Get notified →</a>
              <a class="btn is-line" href="/#summer">Ask about summer camp</a>
            </div>
          </div>
        ) : (
          <div class="k-list">
            {WORKSHOPS.map((w) => <WorkshopCard {...w} />)}
          </div>
        )
      }
    </div>
  </section>

  {/* ─── PHOTO STRIP (below the listing) ─── */}
  <PhotoStrip items={STRIP_ONE} />

  {/* ─── GOOD TO KNOW ─── */}
  <section class="k-know" id="know">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">First time here?</div>
          <h2 class="section-title" style="margin-top: 12px;">
            A few <em>good things</em> to know
          </h2>
          <p class="section-lede">
            New to the cabin? Here's the practical stuff so drop-off day feels easy. Still have a
            question? Christine answers her email personally, just ask!
          </p>
        </div>
      </div>
      <div class="k-know-grid">
        <div class="k-know-card">
          <span class="ic"><Icon name="pin" /></span>
          <h4>Where</h4>
          <p>The log-cabin studio at <b>190 Hope St N in Port Hope</b>. Park on the street; the studio entrance is round the side.</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="car" /></span>
          <h4>Drop-off & pickup</h4>
          <p>Drop off up to 5 min early. Please walk younger kids in and pick them up at the door. Christine likes to say hello!</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="supplies" /></span>
          <h4>What's provided</h4>
          <p>All supplies for the project are included: paints, clay, paper, tools, etc. No need to buy a thing.</p>
        </div>
        <div class="k-know-card">
          <span class="ic"><Icon name="bag" /></span>
          <h4>What to bring</h4>
          <p>Just a smock or an old shirt (art gets messy!) and a water bottle. We'll note anything extra on the workshop.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── PHOTO STRIP (below "First time here?", on cream) ─── */}
  <PhotoStrip items={STRIP_TWO} />

  {/* ─── CTA ─── */}
  <section class="cta">
    <div class="wrap">
      <h2>Ready to get a little <em>paint</em> on them?</h2>
      <p>
        Email Christine to hold a spot, ask about a workshop, or check what's coming up next. She'll
        reply to you directly. No carts, no accounts.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a class="btn is-light" href="mailto:jttacabin@gmail.com">jttacabin@gmail.com</a>
        <a class="btn is-outline" href="https://maps.app.goo.gl/B21tc9VSLLVKoAx69" target="_blank" rel="noopener">Find the cabin →</a>
      </div>
    </div>
  </section>
</BaseLayout>
