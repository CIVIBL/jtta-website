---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AudienceCard from "../components/AudienceCard.astro";
import WorkshopRow from "../components/WorkshopRow.astro";
import ProgramCard from "../components/ProgramCard.astro";
import { isUpcoming } from "../lib/workshops";
import { mailto, CONTACT_EMAIL, MAPS_URL } from "../lib/site";

const upcomingWorkshops = (await getCollection("workshops"))
  .filter((w) => isUpcoming(w.data.date))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 6);

interface Audience {
  label: string;
  meta: string;
  /** Omit when there's no dedicated page yet — card renders as a non-link. */
  href?: string;
}
const AUDIENCES: Audience[] = [
  { label: "For my child", meta: "Workshops · summer camp · ages 6-13", href: "/for-kids" },
  { label: "For myself", meta: "Adult workshops · Evenings", href: "/for-adults" },
  { label: "For a birthday", meta: "Studio party" },
  { label: "For my class", meta: "In-the-Schools · JK to Gr 8" },
];

interface Program {
  tag: string;
  color: string;
  title: string;
  desc: string;
  featured?: boolean;
  photo?: string;
  photoSrc?: string;
  /** Omit when there's no dedicated page yet — card renders as a non-link. */
  href?: string;
}
const PROGRAMS: Program[] = [
  {
    featured: true,
    tag: "Mon-Thu · ages 6-13",
    color: "var(--c-red)",
    title: "Weekly art workshops",
    desc: "After-school workshops in the log-cabin studio. Pick the days that fit - felting, watercolour, clay, mandalas, beading, drawing, painting. Many parents enroll for the whole term, but you don't have to.",
    photo: "About twenty children seated around long wooden tables in the rustic cabin studio, drawing and waving at the camera.",
    photoSrc: "/images/program-workshops.jpg",
    href: "/for-kids",
  },
  {
    tag: "Evenings · adults",
    color: "var(--c-blue)",
    title: "Adult workshops",
    desc: "A friendly studio for adults - watercolour, collage, mixed media. No experience needed.",
    href: "/for-adults",
  },
  {
    tag: "4-11 yrs",
    color: "var(--c-plum)",
    title: "Birthday parties",
    desc: "Pick a project, we set everything up, you eat cake. Take-home art for every guest.",
  },
  {
    tag: "JK - Grade 8 · in your room",
    color: "var(--c-sage)",
    title: "In-the-Schools",
    desc: "We bring all supplies and a 2-period art workshop to your classroom. Open to schools in Port Hope & Cobourg.",
  },
  {
    tag: "July & August · ages 6-13",
    color: "var(--c-yellow)",
    title: "Summer Camp",
    desc: "Music, drama and visual art in one themed week, building to a live Friday performance. Come for one week or make a summer of it.",
    href: "/summer-program",
  },
];

interface Slide {
  src: string;
  alt: string;
}
const CAROUSEL: Slide[] = [
  { src: "/images/carousel-1.jpg", alt: "Children seated in rows facing a small stage in the rustic studio hall, their drawings displayed on the walls beneath a Journey Through the Arts banner." },
  { src: "/images/carousel-2.jpg", alt: "Five smiling kids leaning over a table to show off their finished landscape paintings." },
  { src: "/images/carousel-3.jpg", alt: "Young children gathered around a cloth-covered table, drawing with markers in the studio." },
  { src: "/images/carousel-4.jpg", alt: "A group of young children around a table proudly displaying a grid of their painted self-portraits." },
  { src: "/images/carousel-5.jpg", alt: "Four kids holding up their textured mixed-media paintings in front of a colourful mural." },
  { src: "/images/carousel-6.jpg", alt: "A young artist holding a canvas painting of three colourful tropical birds." },
  { src: "/images/carousel-7.jpg", alt: "A young artist holding a sheet of six lino-cut prints of a winged-heart design in different colours." },
  { src: "/images/carousel-8.jpg", alt: "Four girls sitting on a fallen log outdoors, sketching on paper in the sun." },
];

---

<BaseLayout title="Journey Through the Arts - Creative studio in Port Hope">
  {/* ─── HERO ─── */}
  <section class="hero" id="top">
    <div class="hero-bg">
      <img
        src="/images/hero-cabin.jpg"
        alt="The Journey Through the Arts studio - a two-storey weathered log cabin with white-trimmed windows and a covered porch, set among trees in Port Hope."
        fetchpriority="high"
      />
    </div>
    <div class="hero-scrim"></div>

    <div class="wrap">
      <div class="hero-content">
        <span class="hero-badge">
          <span class="pip">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.5l2.7 6.2 6.7.6-5.1 4.5 1.5 6.6L12 17l-5.8 3.4 1.5-6.6L2.6 9.3l6.7-.6z"></path>
            </svg>
          </span>
          2024 Diamond Award · Best Art School
        </span>
        <h1 class="hero-title">
          A creative studio for <em>curious kids</em> &amp; <span class="stroke"
            >brave adults<svg viewBox="0 0 280 24" preserveAspectRatio="none" aria-hidden="true">
              <path
                d="M 4 14 C 40 4, 100 18, 160 12 S 250 6, 276 14 L 276 22 C 240 16, 180 22, 130 18 S 30 22, 4 18 Z"
                fill="var(--c-yellow)"
                opacity="0.85"></path>
            </svg></span
          >
        </h1>
        <p class="hero-sub">
          Journey Through the Arts is a creative studio in an 1840s log cabin run by Christine
          Benson. Delivering workshops, summer camps, adult classes, birthday parties &amp; in-school
          visits since 2002.
        </p>
        <div class="hero-ctas">
          <a href="#workshops" class="btn is-primary">See this month's workshops</a>
          <a href="#audience" class="btn is-line">Find what you're looking for ↓</a>
        </div>
      </div>
    </div>

    <a class="hero-stamp" href={MAPS_URL} target="_blank" rel="noopener"
      >📍 190 Hope St N · Port Hope</a
    >
  </section>

  {/* ─── AUDIENCE PICKER ─── */}
  <section class="audience" id="audience">
    <div class="wrap">
      <div class="audience-head">
        <div class="ah-title">I'm here for…</div>
        <span class="arrow">Choose a path</span>
      </div>
      <div class="audience-grid">
        {AUDIENCES.map((a) => <AudienceCard label={a.label} meta={a.meta} href={a.href} />)}
      </div>
    </div>
  </section>

  {/* ─── UPCOMING WORKSHOPS (hidden entirely when nothing is scheduled) ─── */}
  {
    upcomingWorkshops.length > 0 && (
      <section class="upcoming" id="workshops">
        <div class="wrap">
          <div class="section-head">
            <div>
              <div class="eyebrow">Upcoming workshops</div>
              <h2 class="section-title" style="margin-top: 12px;">
                Drop in for a <em>workshop!</em>
              </h2>
              <p class="section-lede">
                Choose the workshops that catch your eye - kids after school and on weekends,
                grown-ups in the evening. Special longer workshops run 90 minutes or more. All
                supplies included!
              </p>
            </div>
          </div>

          <div class="upcoming-grid">
            {upcomingWorkshops.map((w) => (
              <WorkshopRow workshop={w} />
            ))}
          </div>

          <div class="upcoming-foot">
            <p>
              <strong>How to register:</strong> Contact Christine via email. She'll confirm your
              spot. Payment at the time of registration.
            </p>
            <a href={mailto("Workshop registration")} class="btn is-primary">
              Contact Christine
            </a>
          </div>
        </div>
      </section>
    )
  }

  {/* ─── PROGRAMS GRID ─── */}
  <section class="programs" id="programs">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">All programs</div>
          <h2 class="section-title" style="margin-top: 12px;">
            Pick your <em>way in.</em>
          </h2>
          <p class="section-lede">
            From weekly drop-ins to birthday parties, summer camps to in-school visits, every program
            is run by Christine out of the cabin (or, for schools, brought to you).
          </p>
        </div>
      </div>

      <div class="programs-grid">
        {
          PROGRAMS.map((p) => (
            <ProgramCard
              tag={p.tag}
              color={p.color}
              title={p.title}
              desc={p.desc}
              featured={p.featured}
              photo={p.photo}
              photoSrc={p.photoSrc}
              href={p.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ─── CAROUSEL (native scroll-snap; arrows + counter need a small script) ─── */}
  <section class="carousel" id="moments">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">From the cabin</div>
          <h2 class="section-title" style="margin-top: 12px;">
            Over twenty years of <em>"can we come back next week?"</em>
          </h2>
          <p class="section-lede">
            A peek at workshops and summer-camp performances from the cabin.
          </p>
        </div>
        <div class="carousel-controls">
          <button class="cbtn" data-carousel="-1" aria-label="Previous photo">←</button>
          <span class="ccount" id="carousel-count">01 / {String(CAROUSEL.length).padStart(2, "0")}</span>
          <button class="cbtn" data-carousel="1" aria-label="Next photo">→</button>
        </div>
      </div>
    </div>

    <div class="carousel-track" id="carousel-track">
      <div class="carousel-pad-left"></div>
      {
        CAROUSEL.map((p, i) => (
          <figure class:list={["cphoto", { "tilt-l": i === 1, "tilt-r": i === 4 }]}>
            <img src={p.src} alt={p.alt} loading="lazy" />
          </figure>
        ))
      }
      <div class="carousel-pad-right"></div>
    </div>
  </section>

  {/* ─── SUMMER ─── */}
  <section class="summer" id="summer">
    <div class="wrap">
      <div class="summer-grid">
        <div class="summer-photo">
          <img
            src="/images/old-art-school.jpg"
            alt="The Old Art School at Molson's Mill in Port Hope - the historic timber-and-stone building where summer camp is held."
          />
          <div class="badge">24th<small>year running</small></div>
        </div>
        <div>
          <div class="eyebrow">Summer camp 2026 · ages 6-13</div>
          <h2 class="section-title" style="margin-top: 12px;">
            One <em>themed week</em>,<br />
            one performance,<br />
            an entire studio.
          </h2>
          <p class="section-lede">
            Our summer arts program delivers Music, Art &amp; Drama at the Old Art School (Molson's
            Mill) in Port Hope. Kids write their own plays, design sets &amp; costumes, compose music,
            and make visual art that goes home Friday. The week ends with an Open House showing the
            production.
          </p>

          <div style="display: flex; gap: 12px; margin-top: 28px; align-items: center; flex-wrap: wrap;">
            <a href="/summer-program" class="btn is-primary">See the full summer program →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ABOUT ─── */}
  <section class="about" id="about">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-photo">
          <img
            src="/images/christine.jpg"
            alt="Christine Benson, founder and instructor at Journey Through the Arts."
          />
        </div>
        <div>
          <div class="eyebrow">About JTtA</div>
          <h2 class="section-title" style="margin-top: 12px;">
            Run by <em>Christine</em><br />
            out of an 1840s<br />
            log cabin.
          </h2>
          <p class="section-lede">
            Founded in 2002 by Christine Benson, OCAD graduate, painter, printmaker, and published
            children's-book illustrator. Christine has taught hundreds of children, teens and adults
            out of her studio at 190 Hope St N.
          </p>

          <div class="about-meta">
            <div><strong>2002</strong><span>Founded</span></div>
            <div><strong>1,000+</strong><span>Kids passed through</span></div>
            <div><strong>2024</strong><span>Diamond winner</span></div>
          </div>

          {/* No /about page yet — rendered as non-link placeholders until it lands. */}
          <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap;">
            <div class="btn is-ghost">Meet Christine →</div>
            <div class="btn is-line">Visit the studio →</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── CTA ─── */}
  <section class="cta">
    <div class="wrap">
      <h2>Come get a little <em>paint</em> on you.</h2>
      <p>
        Email Christine to register, ask about a workshop, get on the summer-camp list, or book a
        birthday. She'll answer directly!
      </p>
      <p class="cta-email"><a href={mailto()}>{CONTACT_EMAIL}</a></p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a class="btn is-light" href={mailto()}>Email Christine</a>
        <a class="btn is-outline" href={MAPS_URL} target="_blank" rel="noopener">Find the cabin →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Carousel controls — strictly necessary for the arrow buttons + live counter.
  // Native scroll-snap handles touch/trackpad swiping without JS.
  const track = document.getElementById("carousel-track");
  const count = document.getElementById("carousel-count");
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".cphoto"));
    const total = cards.length;
    const pad = (n: number) => String(n).padStart(2, "0");

    const step = (dir: number) => {
      const card = cards[0];
      if (!card) return;
      const gap = 18;
      track.scrollBy({ left: dir * (card.getBoundingClientRect().width + gap), behavior: "smooth" });
    };

    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((btn) => {
      btn.addEventListener("click", () => step(Number(btn.dataset.carousel)));
    });

    const update = () => {
      const r = track.getBoundingClientRect();
      const center = r.left + r.width / 2;
      let closest = 0;
      let dist = Infinity;
      cards.forEach((c, i) => {
        const cr = c.getBoundingClientRect();
        const d = Math.abs(cr.left + cr.width / 2 - center);
        if (d < dist) {
          dist = d;
          closest = i;
        }
      });
      if (count) count.textContent = `${pad(closest + 1)} / ${pad(total)}`;
    };

    track.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
