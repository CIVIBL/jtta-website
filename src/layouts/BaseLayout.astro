---
import "../styles/tokens.css";
import "../styles/global.css";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { SITE_URL, STUDIO_NAME, SITE_DESCRIPTION } from "../lib/site";

interface Props {
  title: string;
  /** Page-specific meta and Open Graph description. Falls back to SITE_DESCRIPTION. */
  description?: string;
  /** Forwarded to <Nav> to highlight the current section/page. */
  activeNav?: "kids" | "adults" | "summer" | "about";
  /** For pages that must not be indexed (the 404): emits robots noindex and omits the canonical link. */
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, activeNav, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// Social share image: hero-cabin.jpg cropped to 1.91:1 (scripts/og-share.mjs). Update the size below if regenerated.
const ogImage = new URL("/images/og-share.jpg", SITE_URL).href;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={STUDIO_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="523" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Caveat:wght@500;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    {/* Site-wide announcement banner */}
    <div class="announce">
      <div class="announce-inner">
        <span>
          <span class="announce-dot"></span>
          <strong>Summer 2026 registration is open</strong> - four themed weeks, ages 6-13.
        </span>
        <a href="/summer-program">See the summer program →</a>
      </div>
    </div>

    <Nav active={activeNav} />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
